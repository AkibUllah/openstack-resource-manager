# Backend: "fake" (bundled realistic fixtures, no cloud needed) or "openstack" (needs `pip install .[openstack]`)
OSRM_BACKEND=fake

# Name of the cloud entry in clouds.yaml (same lookup openstacksdk uses: ./clouds.yaml, ~/.config/openstack/, /etc/openstack/)
# OS_CLOUD=dhaka-prod

# Alternative config file location (default: ~/.osrm.toml)
# OSRM_CONFIG=/path/to/osrm.toml

# Custom pricing table (YAML). Defaults to the bundled BDT table.
# OSRM_PRICING=/path/to/pricing.yaml

# Audit thresholds
OSRM_IDLE_DAYS=14
OSRM_IDLE_CPU_PERCENT=5
OSRM_OVERSIZED_CPU_PERCENT=10
OSRM_OVERSIZED_MIN_VCPUS=4
